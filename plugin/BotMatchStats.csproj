<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>BotMatchStats</RootNamespace>
    <AssemblyName>BotMatchStats</AssemblyName>
    <Version>1.2.0</Version>
    <!-- The test project lives below this folder; keep its sources and build output out of the plugin. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);BotMatchStats.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
