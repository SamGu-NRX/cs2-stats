{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CS2 Stats",
  "version": "0.1.0",
  "identifier": "dev.cs2stats.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CS2 Stats",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#ececf0",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
